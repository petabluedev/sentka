generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Load {
  vehicle     String
  createdAt   DateTime  @default(now())
  enclosed    Boolean   @default(false)
  operable    Boolean   @default(true)
  priceCents  Int
  id          String    @id @default(cuid())
  dropoffCity String
  pickupCity  String
  pickupLat   Float?
  pickupLng   Float?
  dropoffLat  Float?
  dropoffLng  Float?
  vehicleType String
  distance    Int?
  pickupDate  DateTime?
  postedById  String?
  postedBy    User?     @relation(fields: [postedById], references: [id])
  assignedDriverId String?
  assignedDriver   User?    @relation("AssignedDriver", fields: [assignedDriverId], references: [id])
  assignmentStatus AssignmentStatus @default(UNASSIGNED)
  assignmentVersion Int @default(0)
  ePODApprovedAt DateTime?
  ePODApprovedById String?
  ePODApprovedBy   User?    @relation("LoadEPODApproval", fields: [ePODApprovedById], references: [id])
  payments    Payment[]
  bids        Bid[]
  earnings    Earning[]
  jobOffers   JobOffer[]
}

model User {
  id         String     @id @default(cuid())
  email      String     @unique
  password   String
  username   String     @unique
  name       String?
  role       UserRole   @default(SHIPPER)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  lastLoginAt DateTime?
  profile    Profile?
  connectAccountId String?
  sessions   Session[]
  passwordResets PasswordReset[]
  loads      Load[]
  assignedLoads Load[] @relation("AssignedDriver")
  ePODApprovals Load[]    @relation("LoadEPODApproval")
  bids       Bid[]       @relation("DriverBids")
  earnings   Earning[]
  payouts    Payout[]
  payoutDestinations PayoutDestination[]
  driverLocation DriverLocation?
  driverStatus   DriverStatus?
  jobOffers      JobOffer[]
}

model Profile {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id])
  userId       String    @unique
  companyName  String?
  phone        String?
  city         String?
  state        String?
}

model Session {
  id         String   @id @default(cuid())
  token      String   @unique
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  userAgent  String?
}

model PasswordReset {
  id         String   @id @default(cuid())
  token      String   @unique
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())
}

model Payment {
  id               String    @id @default(cuid())
  load             Load      @relation(fields: [loadId], references: [id])
  loadId           String
  payerId          String
  payeeId          String?
  payeeConnectId   String?
  transferId       String?
  amountCents      Int
  currency         String    @default("usd")
  paymentIntentId  String    @unique
  status           PaymentStatus @default(PENDING)
  captured         Boolean   @default(false)
  releasedAt       DateTime?
  refundedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  notes            String?
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum UserRole {
  SHIPPER
  DRIVER
  ADMIN
}

model Bid {
  id         String    @id @default(cuid())
  load       Load      @relation(fields: [loadId], references: [id])
  loadId     String
  driver     User      @relation("DriverBids", fields: [driverId], references: [id])
  driverId   String
  amountCents Int
  status     BidStatus @default(PENDING)
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
}

model Earning {
  id         String        @id @default(cuid())
  jobId      String        @unique
  job        Load          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId   String
  driver     User          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amountCents Int
  status     EarningStatus @default(PENDING)
  approvedAt DateTime?
  paidAt     DateTime?
  payoutId   String?
  payout     Payout?       @relation(fields: [payoutId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Payout {
  id              String       @id @default(cuid())
  driverId        String
  driver          User         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amountGrossCents Int
  feeAmountCents  Int
  amountNetCents  Int
  method          PayoutMethod
  railUsed        PayoutRail?
  status          PayoutStatus @default(CREATED)
  destinationMask String?
  providerReferenceId String?
  idempotencyKey  String?
  createdAt       DateTime     @default(now())
  initiatedAt     DateTime?
  processedAt     DateTime?
  earnings        Earning[]

  @@unique([driverId, idempotencyKey])
}

model LedgerEntry {
  id            String        @id @default(cuid())
  refType       LedgerRefType
  refId         String
  debitAccount  String
  creditAccount String
  amountCents   Int
  createdAt     DateTime      @default(now())

  @@unique([refType, refId, debitAccount, creditAccount])
}

model PayoutDestination {
  id             String               @id @default(cuid())
  driverId       String
  driver         User                 @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type           PayoutDestinationType
  tokenReference String
  mask           String
  isDefault      Boolean              @default(false)
  createdAt      DateTime             @default(now())

  @@unique([driverId, type, tokenReference])
}

model DriverLocation {
  driverId     String   @id
  driver       User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  accuracyM    Int?
  headingDeg   Int?
  speedMps     Float?
  capturedAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model DriverStatus {
  driverId     String           @id
  driver       User             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  availability DriverAvailability @default(OFFLINE)
  vehicleType  VehicleType?
  capacityTag  String[] @default([])
  homeZone     String?
  lastSeenAt   DateTime?        @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
}

model JobOffer {
  id          String          @id @default(uuid())
  jobId       String
  job         Load            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  driverId    String
  driver      User            @relation(fields: [driverId], references: [id], onDelete: Cascade)
  offerStatus JobOfferStatus
  offeredAt   DateTime        @default(now()) @db.Timestamptz(3)
  respondedAt DateTime?       @db.Timestamptz(3)
  expiresAt   DateTime        @db.Timestamptz(3)
  score       Float
  distanceKm  Float
  attempt     Int             @default(1)

  @@unique([jobId, driverId, attempt])
  @@index([jobId, offerStatus])
  @@index([driverId, offeredAt])
}

enum BidStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum AssignmentStatus {
  UNASSIGNED
  OFFERING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
  ON_TRIP
  PAUSED
}

enum JobOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELED
}

enum VehicleType {
  SEDAN
  SUV
  VAN
  BOX_TRUCK
  CAR_HAULER
}

enum EarningStatus {
  PENDING
  APPROVED
  PAID
}

enum PayoutMethod {
  WEEKLY_ACH
  INSTANT_DEBIT
}

enum PayoutRail {
  FEDNOW
  RTP
  INSTANT_DEBIT
  ACH_SAME_DAY
  ACH_STANDARD
}

enum PayoutStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
}

enum LedgerRefType {
  EARNING
  PAYOUT
}

enum PayoutDestinationType {
  BANK_ACH
  DEBIT_CARD
}
